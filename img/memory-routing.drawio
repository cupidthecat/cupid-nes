        <mxCell id="cpu_note" value="Board decoding can treat reads and writes differently." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#52657A;fontStyle=0;spacing=0;" vertex="1" parent="cpu_panel">
