        <mxCell id="cpu_hint" value="Three broad regions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#52657A;fontStyle=0;spacing=0;" vertex="1" parent="cpu_panel">
          <mxGeometry x="27.0" y="44.0" width="590" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ppu_hint" value="Pattern, nametable and palette space" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#52657A;fontStyle=0;spacing=0;" vertex="1" parent="ppu_panel">
          <mxGeometry x="27.0" y="44.0" width="590" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cpu_ram" value="$0000-$1FFF&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#52657A&quot;&gt;2 KiB internal RAM, mirrored on an ordinary NES&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E7F6F3;strokeColor=#49A394;strokeWidth=1.5;fontFamily=Helvetica;fontSize=17;fontColor=#183153;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="cpu_panel">
          <mxGeometry x="30.0" y="85.0" width="615" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cpu_io" value="$2000-$401F&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#52657A&quot;&gt;PPU, APU, controller and DMA registers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF0E5;strokeColor=#D98A4C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=17;fontColor=#183153;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="cpu_panel">
          <mxGeometry x="30.0" y="205.0" width="615" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cpu_cart" value="$4020-$FFFF&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#52657A&quot;&gt;Cartridge registers, PRG ROM and cartridge RAM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4DB;strokeColor=#D4A13B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=17;fontColor=#183153;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="cpu_panel">
          <mxGeometry x="30.0" y="325.0" width="615" height="95" as="geometry" />
        </mxCell>
        <mxCell id="ppu_chr" value="$0000-$1FFF  |  Pattern tables&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#52657A&quot;&gt;CHR data is selected through the mapper&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E7F6F3;strokeColor=#49A394;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#183153;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="ppu_panel">
          <mxGeometry x="30.0" y="85.0" width="615" height="95" as="geometry" />
