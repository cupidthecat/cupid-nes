        <mxCell id="ppu_pal" value="$3F00-$3FFF  |  Palette&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#52657A&quot;&gt;Palette RAM is internal to the PPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E7F6F3;strokeColor=#49A394;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#183153;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="ppu_panel">
          <mxGeometry x="30.0" y="325.0" width="615" height="95" as="geometry" />
