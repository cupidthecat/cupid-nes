        <mxCell id="title" value="CPU and PPU address maps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#183153;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="35" width="1390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Address ranges reach different devices; the mapper chooses cartridge-backed memory." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#52657A;fontStyle=0;spacing=0;" vertex="1" parent="1">
