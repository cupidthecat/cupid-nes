        <mxCell id="ppu_panel" value="PPU address map" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#DCE4EE;strokeWidth=1.5;fontFamily=Helvetica;fontSize=18;fontColor=#183153;fontStyle=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=22;container=1;pointerEvents=0;" vertex="1" parent="1">
